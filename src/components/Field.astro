---
import type { Field } from '../lib/types';
interface Props { field: Field; hideLabel?: boolean }
const f = Astro.props.field;
const id = `f-${f.id}`;
// The split layout prints this field's label in the panel header, so the
// visible <label> here would be a duplicate. Keep it in the accessibility
// tree via aria-label — hiding a label must not unname the control.
const hideLabel = Astro.props.hideLabel === true;
---
{f.type === 'checkbox' ? (
  <div class="field inline">
    <input type="checkbox" id={id} checked={f.default === true} />
    <label for={id}>{f.label}</label>
  </div>
) : (
  <div class="field">
    {!hideLabel && (
      <label for={id}>
        {f.label}
        {f.type === 'range' && <span class="counts"> — <span id={`v-${f.id}`}>{f.default}</span></span>}
      </label>
    )}

    {f.type === 'textarea' && (
      <textarea id={id} class={f.mono ? 'mono' : ''} aria-label={hideLabel ? f.label : undefined} placeholder={f.placeholder} spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off">{f.default}</textarea>
    )}
    {f.type === 'text' && (
      <input type="text" id={id} class={f.mono ? 'mono' : ''} placeholder={f.placeholder} value={f.default} spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" />
    )}
    {f.type === 'number' && (
      <input type="number" id={id} value={f.default} min={f.min} max={f.max} step={f.step} />
    )}
    {f.type === 'range' && (
      <input type="range" id={id} value={f.default} min={f.min} max={f.max} step={f.step} />
    )}
    {f.type === 'color' && <input type="color" id={id} value={f.default} />}
    {f.type === 'text-color' && (
      <span class="color-combo">
        <input type="text" id={id} class={f.mono ? 'mono' : ''} placeholder={f.placeholder} value={f.default} spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" />
        <input type="color" id={`${id}-picker`} value={f.default} aria-label={`${f.label} — 取色器`} />
      </span>
    )}
    {f.type === 'select' && (
      <select id={id}>
        {f.options?.map((o) => <option value={o.value} selected={o.value === f.default}>{o.label}</option>)}
      </select>
    )}

    {f.hint && <span class="hint">{f.hint}</span>}
  </div>
)}
